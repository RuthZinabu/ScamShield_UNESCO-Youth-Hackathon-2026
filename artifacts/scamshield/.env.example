# Base URL of the Tebaqi API server (no trailing slash).
# Copy this file to .env.local for local development, or set it as a
# Render environment variable for production deployments.
#
# Local dev example (if you run the API server on port 5000):
VITE_API_URL=http://localhost:5000

# Production example:
# VITE_API_URL=https://trustlense-unesco-youth-hackathon-2026-2.onrender.com
